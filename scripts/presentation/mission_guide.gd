static func mission(quest_id: String) -> Dictionary:
	return MISSIONS.get(quest_id, {})

static func is_current(quest_id: String) -> bool:
	return MISSIONS.has(quest_id)

static func step(stage_id: String) -> Dictionary:
	return STEPS.get(stage_id, {})

static func where_text(step_data: Dictionary) -> String:
	var parts: Array[String] = []
	for key in step_data.get("where", []):
		parts.append(str(WHERE_LABELS.get(str(key), key)))
	return " · ".join(parts)

static func prompt(interaction_id: String, fallback: String) -> String:
	return str(INTERACTIONS.get(interaction_id, {}).get("prompt", fallback))

static func materials(interaction_id: String, authored: Array) -> Array:
	var override: Array = INTERACTIONS.get(interaction_id, {}).get("materials", [])
	return override if not override.is_empty() else authored

static func how_steps(interaction_id: String) -> Array:
	return INTERACTIONS.get(interaction_id, {}).get("how", [])

static func field_label(interaction_id: String, field_id: String, fallback: String) -> String:
	return str(INTERACTIONS.get(interaction_id, {}).get("fields", {}).get(field_id, fallback))

## Replacement wording is used only when it matches the authored list one to one:
## saved checks are stored by position, never by text.
static func criteria(stage_id: String, interaction_id: String, authored: Array) -> Array:
	var interaction_override: Array = INTERACTIONS.get(interaction_id, {}).get("criteria", [])
	if not interaction_override.is_empty() and interaction_override.size() == authored.size():
		return interaction_override
	var stage_override: Array = CRITERIA.get(stage_id, [])
	if not stage_override.is_empty() and stage_override.size() == authored.size():
		return stage_override
	return authored

## Position of the stage in the authored list, 1-based, and the list length.
static func position(stages: Array, stage_id: String) -> Vector2i:
	for i in range(stages.size()):
		if str(stages[i].get("stage_id", "")) == stage_id:
			return Vector2i(i + 1, stages.size())
	return Vector2i(0, stages.size())

## Envelope of the current FG01 scene as (number, total) or Vector2i.ZERO.
static func envelope_position(quest: Dictionary, interaction_id: String) -> Vector2i:
	var envelopes: Array = quest.get("adventure", {}).get("envelopes", [])
	for entry in envelopes:
		if entry.get("interaction_ids", []).has(interaction_id):
			return Vector2i(int(entry.get("number", 0)), envelopes.size())
	return Vector2i.ZERO

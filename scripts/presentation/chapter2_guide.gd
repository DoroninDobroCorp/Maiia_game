static func mission(mid: String) -> Dictionary:
	return MISSIONS.get(mid, {})

static func step_def(mid: String, step_id: String) -> Dictionary:
	for step in MISSIONS.get(mid, {}).get("steps", []):
		if str(step.id) == step_id:
			return step
	return {}

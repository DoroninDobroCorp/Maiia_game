static func series(series_id: String) -> Dictionary:
	return SERIES.get(series_id, {})

## Все сцены серии подряд с номером главы.
static func scenes(series_id: String) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for chapter in SERIES.get(series_id, {}).get("chapters", []):
		for scene in chapter.scenes:
			var item: Dictionary = scene.duplicate(true)
			item["chapter_id"] = chapter.id
			item["chapter_title"] = chapter.title
			item["stage_id"] = chapter.get("stage_id", "")
			result.append(item)
	return result

static func scene(series_id: String, scene_id: String) -> Dictionary:
	for item in scenes(series_id):
		if str(item.id) == scene_id:
			return item
	return {}

## Подставляет {токены}: выбор и ответы Майи, а если их ещё нет, значение по умолчанию.
static func render(text: String, series_id: String, tokens: Dictionary) -> String:
	var defaults: Dictionary = SERIES.get(series_id, {}).get("defaults", {})
	var result := text
	for key in defaults.keys():
		result = result.replace("{" + str(key) + "}", str(tokens.get(key, defaults[key])))
	for key in tokens.keys():
		result = result.replace("{" + str(key) + "}", str(tokens[key]))
	return result
